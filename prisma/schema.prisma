generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())
  clerk_id String @unique
  email String? @unique
  firstName String?
  lastName String?
  imageUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}